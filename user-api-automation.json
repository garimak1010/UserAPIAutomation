  "item": [
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "let data = pm.response.json();\r",
              "\r",
              "console.log(\"Response Data:\", data);\r",
              "\r",
              "pm.test(\"User name is correct\", function () {\r",
              "    pm.expect(data.name).to.eql(\"Garima\");\r",
              "});\r",
              "\r",
              "// 🔥 Use COLLECTION variable (since env had issues)\r",
              "pm.collectionVariables.set(\"userId\", data.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Garima\",\r\n  \"email\": \"garima@test.com\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
